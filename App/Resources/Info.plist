	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>AgentDefaultAPIKey</key>
	<string>$(AGENT_API_KEY)</string>
	<key>AgentDefaultZenMuxAPIKey</key>
	<string>$(ZENMUX_API_KEY)</string>
